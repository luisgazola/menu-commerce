generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ProductOptionType {
  SINGLE
  MULTIPLE
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum PromotionScope {
  STORE
  CATEGORY
  PRODUCT
}

model Company {
  id             String       @id @default(uuid())
  legalName      String
  tradeName      String
  documentNumber String?      @unique
  phone          String?
  whatsapp       String?
  email          String?
  status         RecordStatus @default(ACTIVE)
  users          User[]
  stores         Store[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Store {
  id                      String                @id @default(uuid())
  companyId               String
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String                @unique
  description             String?
  logoUrl                 String?
  bannerUrl               String?
  whatsapp                String?
  whatsappEnabled         Boolean               @default(true)
  whatsappMessageTemplate String?
  isOpen                  Boolean               @default(true)
  status                  RecordStatus          @default(ACTIVE)
  categories              Category[]
  products                Product[]
  orders                  Order[]
  coupons                 Coupon[]
  promotions              Promotion[]
  paymentConfig           PaymentGatewayConfig?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([companyId])
}

model User {
  id           String       @id @default(uuid())
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(ADMIN)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Category {
  id           String       @id @default(uuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  imageUrl     String?
  displayOrder Int          @default(0)
  status       RecordStatus @default(ACTIVE)
  products     Product[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status, displayOrder])
}

model Product {
  id               String               @id @default(uuid())
  storeId          String
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             String
  slug             String
  description      String?
  price            Decimal              @db.Decimal(10, 2)
  promotionalPrice Decimal?             @db.Decimal(10, 2)
  imageUrl         String?
  preparationTime  Int?
  featured         Boolean              @default(false)
  status           RecordStatus         @default(ACTIVE)
  optionGroups     ProductOptionGroup[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, categoryId, status])
  @@index([storeId, name])
}

model ProductOptionGroup {
  id               String              @id @default(uuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  type             ProductOptionType   @default(SINGLE)
  required         Boolean             @default(false)
  minimumSelection Int                 @default(0)
  maximumSelection Int                 @default(1)
  displayOrder     Int                 @default(0)
  items            ProductOptionItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([productId, displayOrder])
}

model ProductOptionItem {
  id              String             @id @default(uuid())
  groupId         String
  group           ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  additionalPrice Decimal            @default(0) @db.Decimal(10, 2)
  displayOrder    Int                @default(0)
  status          RecordStatus       @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([groupId, displayOrder, status])
}

enum ServiceType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CARD_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  MERCADO_PAGO
  PAGBANK
  STRIPE
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  orders    Order[]
  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  postalCode String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  reference  String?
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id          String               @id @default(uuid())
  storeId     String
  store       Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressId   String?
  address     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  orderNumber String               @unique
  serviceType ServiceType
  status      OrderStatus          @default(RECEIVED)
  subtotal    Decimal              @db.Decimal(10, 2)
  deliveryFee Decimal              @default(0) @db.Decimal(10, 2)
  discount    Decimal              @default(0) @db.Decimal(10, 2)
  couponCode  String?
  total       Decimal              @db.Decimal(10, 2)
  notes       String?
  items       OrderItem[]
  statusLog   OrderStatusHistory[]
  payments    Payment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  productNameSnapshot String
  unitPrice           Decimal  @db.Decimal(10, 2)
  quantity            Int
  optionsTotal        Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice          Decimal  @db.Decimal(10, 2)
  notes               String?
  options             Json
  createdAt           DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Coupon {
  id               String        @id @default(uuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code             String
  description      String?
  discountType     DiscountType
  discountValue    Decimal       @default(0) @db.Decimal(10, 2)
  minimumOrder     Decimal       @default(0) @db.Decimal(10, 2)
  maximumDiscount  Decimal?      @db.Decimal(10, 2)
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int?
  usagePerCustomer Int?
  firstOrderOnly   Boolean       @default(false)
  combinable       Boolean       @default(false)
  status           RecordStatus  @default(ACTIVE)
  usages           CouponUsage[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status, startsAt, endsAt])
}

model CouponUsage {
  id            String   @id @default(uuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  customerPhone String
  discount      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@index([couponId, customerPhone])
}

model Promotion {
  id              String         @id @default(uuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  scope           PromotionScope @default(STORE)
  targetId        String?
  discountType    DiscountType
  discountValue   Decimal        @default(0) @db.Decimal(10, 2)
  minimumQuantity Int            @default(1)
  startsAt        DateTime
  endsAt          DateTime
  priority        Int            @default(0)
  combinable      Boolean        @default(false)
  status          RecordStatus   @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId, status, startsAt, endsAt, priority])
}

model PaymentGatewayConfig {
  id                    String          @id @default(uuid())
  storeId               String          @unique
  store                 Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider              PaymentProvider @default(MOCK)
  enabled               Boolean         @default(false)
  sandbox               Boolean         @default(true)
  publicKey             String?
  pixEnabled            Boolean         @default(false)
  creditCardEnabled     Boolean         @default(false)
  debitCardEnabled      Boolean         @default(false)
  cashEnabled           Boolean         @default(true)
  cardOnDeliveryEnabled Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider @default(MOCK)
  method                PaymentMethod
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(10, 2)
  providerTransactionId String?         @unique
  pixCode               String?
  pixQrCodeUrl          String?
  failureReason         String?
  approvedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, status])
}

model PaymentEvent {
  id         String          @id @default(uuid())
  provider   PaymentProvider
  externalId String?
  eventType  String
  payload    Json
  processed  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([provider, externalId])
}
